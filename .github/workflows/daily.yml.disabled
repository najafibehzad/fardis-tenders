name: deploy-pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  pages: write
  id-token: write

concurrency:
  group: fardis-pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - name: آماده‌سازی سایت از گزارش کامیت‌شده
        run: |
          mkdir -p site
          if [ -f report.html ]; then cp report.html site/index.html; else echo "NO-REPORT: report.html not in repo"; exit 1; fi
          if [ -f report.pdf ]; then cp report.pdf site/report.pdf; fi

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: site

      - uses: actions/deploy-pages@v4
